{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# Automatic HTTPS with Let's Encrypt (when domain is set)
# For local dev without a domain, use http://
{$DOMAIN:localhost} {
	# Compression
	encode {
		gzip
		zstd
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Backend API — WebSocket support is automatic in Caddy
	handle_path /api/* {
		request_body {
			max_size 100MB
		}
		reverse_proxy backend:8000
	}

	# Health check
	handle_path /health {
		reverse_proxy backend:8000
	}

	# OpenAPI spec
	handle_path /api/openapi.json {
		reverse_proxy backend:8000
	}

	# Everything else → frontend SPA
	handle {
		reverse_proxy frontend:80
	}
}
